# SignHome Environment Configuration

# Backend Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
# Default connects to local MongoDB or falls back to robust local embedded/JSON storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=signhome_db

# Security & Authentication
JWT_SECRET_KEY=signhome_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/ML Configuration
ML_MODEL_PATH=ml-model/saved_models/isl_gesture_classifier.joblib
ML_CONFIDENCE_THRESHOLD=0.65
ML_PREDICTION_SMOOTHING_WINDOW=5

# Primary Online ISL Data Sources (Attribution & Verification)
ARGISL_BASE_URL=https://cs.rkmvu.ac.in/~isl/
ISL_PORTAL_BASE_URL=https://indiansignlanguage.org/
